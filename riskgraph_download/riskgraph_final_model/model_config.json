{
  "model_name": "RiskGraph",
  "version": "1.0",
  "xgboost": {
    "type": "XGBClassifier"
  },
  "graphsage": {
    "type": "RiskGraphSAGE",
    "hidden_dim": 64,
    "embedding_dim": 32
  },
  "isolation_forest": true,
  "calibration": true,
  "decision_threshold": 0.05,
  "risk_bands": {
    "LOW": [
      0.0,
      0.2
    ],
    "MEDIUM": [
      0.2,
      0.5
    ],
    "HIGH": [
      0.5,
      0.8
    ],
    "CRITICAL": [
      0.8,
      1.0
    ]
  },
  "cost_model": {
    "false_positive_cost": 20,
    "false_negative_cost": 1000
  },
  "feature_count": 97
}